Table users {
  id uint [primary key]
  name varchar(50) [not null, unique]
  full_name varchar(100) [not null]
  email varchar(255) [not null, unique]
  address varchar(100) [not null]
  password varchar(255) [not null]

  created_at timestamp [default: `now()`]
  deleted_at timestamp [default: null]
}

Table properties {
  id uint [primary key]
  NOP_PBB char(18) [not null, unique]
  title varchar(255) [not null]
  description text [not null]
  price decimal(17, 2) [not null]
  address varchar(255) [not null] 
  status boolean [default: true] // true: available, false: sold

  owner_id uint [not null]  
  type_id uint [not null]

  created_at timestamp [default: `now()`]
  deleted_at timestamp [default: null]
}

Table property_types {
  id uint [primary key]
  name varchar(50) [not null, unique]
}

Table facility_types {
  id uint [primary key]
  name varchar(50) [not null, unique]
}

Table property_facilities {
  id uint [primary key]
  property_id uint [not null]
  facility_type_id uint [not null]
}

Table transactions {
  id uint [primary key]
  property_id uint [not null]
  buyer_id uint [not null]
  price decimal(17, 2) [not null]
  status varchar(20) [not null] // e.g., 'pending', 'paid', 'cancelled'
  transaction_date timestamp [default: `now()`]

  created_at timestamp [default: `now()`]
}

// One to Many: One user can own many properties
Ref: users.id < properties.owner_id

// One to Many: One property type can be associated with many properties
Ref: property_types.id < properties.type_id

// Many to Many: A property can have multiple facilities, and a facility can be associated with multiple properties
Ref: properties.id < property_facilities.property_id
Ref: facility_types.id < property_facilities.facility_type_id

// One to Many: One property can have many transactions, but each transaction is for one property
Ref: properties.id < transactions.property_id

// One to Many: One user can be the buyer in many transactions, but each transaction has one buyer
Ref: users.id < transactions.buyer_id

