Table users {
  id                int              [primary key]

  username          varchar(50)       [not null, unique]
  full_name         varchar(100)      [not null]
  email             varchar(255)      [not null, unique]
  phone_number      varchar(20)       [not null]
  password          varchar(255)      [not null]

  created_at        timestamp         [default: `now()`]
  deleted_at        timestamp         [default: null]
}

Table agencies {
  id                int              [primary key]

  agency_name       varchar(100)      [not null, unique]
  address           varchar(255)      [not null]
  phone_number      varchar(20)       [not null]
  email             varchar(255)      [not null, unique]

  created_at        timestamp         [default: `now()`]
  deleted_at        timestamp         [default: null]
}

Table agents {
  id                int               [primary key]
  user_id           int               [not null, unique] // Agent is also a user
  agency_id         int               // An agent *may* not be associated with an agency. So *an* owner can be an agent too.

  bio_description   text              [not null]
  is_verified       boolean           [default: false]

  created_at        timestamp         [default: `now()`]
  deleted_at        timestamp         [default: null]
}

Table properties {
  id                int               [primary key]
  type_id           int               [not null]
  agent_id          int               [not null] // In this website, no properties have more than one agent

  NOP_PBB           char(18)          [not null, unique]
  title             varchar(255)      [not null]
  description       text              [not null]
  price             decimal(17, 2)    [not null]
  address           varchar(255)      [not null]
  city              varchar(100)      [not null] // For filtering
  province          varchar(100)      [not null] // For filtering 
  listing_type      varchar(20)       [not null] // 'rent' or 'sell' or 'lease'
  status            varchar(20)       [default: 'available'] // 'available', 'sold'

  created_at        timestamp         [default: `now()`]
  deleted_at        timestamp         [default: null]
}

Table property_types {
  id                int               [primary key]
  name              varchar(50)       [not null, unique]
}

Table facility_types {
  id                int               [primary key]
  name              varchar(50)       [not null, unique]
}

Table property_facilities {
  id                int               [primary key]
  property_id       int               [not null]
  facility_type_id  int               [not null]

  // A property can have multiple facilities, but each facility type can only be associated with a property once
  indexes {
    (property_id, facility_type_id)   [unique]  
  }
}

// [FEATURE] A property can have multiple images, and there is always one image to be the cover image
Table property_images {
  id                int               [primary key]
  property_id       int               [not null]

  image_url         varchar(255)      [not null]
  is_primary        boolean           [default: false] // For displaying cover image on page
  sort_order        int               [default: 0] // For ordering images

  created_at        timestamp         [default: `now()`]
}

// [FEATURE] Users can add  properties to a wishlist, so they can save them for later without making a deal.
Table wishlists {
  id                int               [primary key]
  user_id           int               [not null]
  property_id       int               [not null]

  created_at        timestamp         [default: `now()`]

  // A user can only have a property in their wishlist once
  indexes {
    (user_id, property_id)            [unique]  
  }
}

// [FEATURE] For every deal made, a user can leave a review.
Table reviews {
  id                int               [primary key]
  user_id           int               [not null]
  property_id       int               [not null] 

  rating            tinyint           [not null]
  comment           text              

  created_at        timestamp         [default: `now()`]
  deleted_at        timestamp         [default: null]

  // A user can only review a property once
  indexes {
    (user_id, property_id)            [unique]  
  }
}

Ref: users.id - agents.user_id

Ref: agents.agency_id < agencies.id

Ref: properties.type_id < property_types.id
Ref: properties.id < property_facilities.property_id
Ref: facility_types.id < property_facilities.facility_type_id
Ref: properties.agent_id < agents.id
Ref: properties.id > property_images.property_id

Ref: users.id < wishlists.user_id
Ref: properties.id < wishlists.property_id

Ref: users.id < reviews.user_id
Ref: properties.id < reviews.property_id


